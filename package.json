{
  "name": "leaflet-extra-markers",
  "version": "2.0.0",
  "description": "Custom map markers for Leaflet JS",
  "homepage": "https://github.com/coryasilva/Leaflet.ExtraMarkers#readme",
  "bugs": {
    "url": "https://github.com/coryasilva/Leaflet.ExtraMarkers/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/coryasilva/Leaflet.ExtraMarkers"
  },
  "author": {
    "name": "Cory Silva",
    "url": "https://corysilva.com"
  },
  "keywords": [
    "leaflet",
    "map",
    "mapmarker",
    "markers",
    "pin",
    "symbol",
    "symbology"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "package.json",
    "README.md",
    "LICENSE",
    "src/**/*.js",
    "src/**/*.d.ts",
    "!src/**/*.test.js"
  ],
  "scripts": {
    "test": "@biomejs/biome lint && ava && tsc index.d.ts",
    "build:markers": "node ./scripts/build-markers.js",
    "optimize": "node ./scripts/optimize-svgs.js"
  },
  "peerDependencies": {
    "leaflet": "^2.0.0-alpha.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "ava": "^6.4.1",
    "leaflet": "^2.0.0-alpha.1",
    "prettier": "^3.6.2",
    "svgson": "^5.3.1",
    "typescript": "^5.3.3"
  }
}
